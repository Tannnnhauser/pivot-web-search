{
  "mcpServers": {
    "pivot-web-search": {
      "command": "uv",
      "args": ["run", "python", "-m", "pivot_web_search_mcp"],
      "cwd": ".",
      "env": {
        "PIVOT_USERCONFIG_TAVILY_API_KEY": "${user_config.tavily_api_key}",
        "PIVOT_USERCONFIG_BRAVE_API_KEY": "${user_config.brave_api_key}",
        "PIVOT_USERCONFIG_GEMINI_SEARCH_API_KEY": "${user_config.gemini_api_key}",
        "PIVOT_USERCONFIG_PROXY_URLS": "${user_config.proxy_urls}"
      },
      "env_vars": [
        "TAVILY_API_KEY",
        "BRAVE_API_KEY",
        "GEMINI_SEARCH_API_KEY",
        "GOOGLE_STUDIO_API_KEY",
        "PIVOT_WEB_SEARCH_PROXIES",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY"
      ]
    }
  }
}
