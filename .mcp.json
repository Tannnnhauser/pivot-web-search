{
  "mcpServers": {
    "pivot-web-search": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-m", "pivot_web_search_mcp"],
      "env": {
        "TAVILY_API_KEY": "${user_config.tavily_api_key}",
        "BRAVE_API_KEY": "${user_config.brave_api_key}",
        "GEMINI_SEARCH_API_KEY": "${user_config.gemini_api_key}",
        "PIVOT_WEB_SEARCH_PROVIDERS": "${user_config.enabled_providers}",
        "PIVOT_WEB_SEARCH_PROXIES": "${user_config.proxy_urls}",
        "PIVOT_WEB_SEARCH_GEMINI_QUOTA": "${user_config.gemini_daily_quota}"
      }
    }
  }
}
